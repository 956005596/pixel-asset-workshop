                      "type": "string",
                      "enum": [
                        "linear",
                        "in",
                        "out",
                        "smooth"
                      ]
                    },
                    "blend": {
                      "type": "string",
                      "enum": [
                        "normal",
                        "add"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false,
              "description": "新增时可省略字段，按默认值补齐。image需要导入PNG，不能只改shape凭空创建素材。"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "columns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16,
            "description": "0为自动排列。"
          },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31,
            "description": "从0开始的单帧索引，必须小于实际帧数。"
          },
          "preview": {
            "type": "object",
            "properties": {
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31,
                  "description": "从0开始，必须小于实际帧数。"
                }
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "cellSize": {
                "type": "integer",
                "minimum": 32,
                "maximum": 256
              },
              "background": {
                "type": "string",
                "enum": [
                  "checker",
                  "dark",
                  "light"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "required": [
      "version"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "previewSchema": {
    "type": "object",
    "properties": {
      "frames": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "description": "从0开始，必须小于实际帧数。"
        }
      },
      "columns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "cellSize": {
        "type": "integer",
        "minimum": 32,
        "maximum": 256
      },
      "background": {
        "type": "string",
        "enum": [
          "checker",
          "dark",
          "light"
        ]
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "executionOrder": [
    "load projectPath if supplied",
    "apply recipePath if supplied",
    "apply effect settings/template",
    "apply module operations in order",
    "import PNG assets in order",
    "diagnose and export"
  ],
  "browserAPI": {
    "entry": "window.PixelWorkshop.call(method, args)",
    "envelope": "{ok, apiVersion, revision, result} or {ok:false, apiVersion, revision, error:{code,message,details}}",
    "conflictField": "expectedRevision",
    "methods": [
      "describe",
      "getState",
      "getProject",
      "listPresets",
      "setEffect",
      "patchEffect",
      "applyRecipe",
      "loadProject",
      "restoreRevision",
      "importAsset",
      "inspect",
      "preview",
      "exportBundle"
    ]
  },
  "errors": [
    "UNKNOWN_FIELD",
    "UNKNOWN_PRESET",
    "UNKNOWN_MODULE",
    "UNKNOWN_OPERATION",
    "INVALID_ARGUMENT",
    "VALIDATION_ERROR",
    "REVISION_CONFLICT",
    "INVALID_ASSET",
    "EMPTY_ASSET",
    "PROJECT_TOO_LARGE",
    "RECIPE_TOO_LARGE",
    "FILE_NOT_FOUND",
    "INVALID_JSON",
    "OUTPUT_EXISTS",
    "BROWSER_NOT_FOUND",
    "CANCELLED"
  ],
  "notes": [
    "JSON Schema提供单字段范围；实际运行还校验模块容量、时间总和、唯一ID、素材帧数和预算。",
    "图集、单帧透明；preview为带底色和标签的观察图。",
    "所有输出目录必须新建，便于回退；CLI不持久启动服务。"
  ]
}
